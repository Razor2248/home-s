# PostgreSQL — tạo DB trước:  createdb home_services  (hoặc chạy bằng Docker, xem README)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/home_services?schema=public"

# JWT
JWT_SECRET="doi-secret-nay-khi-deploy-123456"
JWT_EXPIRES="15m"
REFRESH_EXPIRES_DAYS=7

# Server
PORT=3001
# CORS: danh sách origin được phép, ngăn cách bằng dấu phẩy.
# Frontend dự án này chạy ở port 3000 (hoặc 5173 nếu tự chạy Vite mặc định).
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"
